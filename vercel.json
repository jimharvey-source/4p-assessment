{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/report.js": { "includeFiles": "api/_fonts/**" },
    "api/submit.js": { "includeFiles": "api/_fonts/**" }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
